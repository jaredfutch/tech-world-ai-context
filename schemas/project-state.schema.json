{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tech-worldllc.com/ai-context/schemas/project-state.schema.json",
  "title": "Tech-World Private Project Current State",
  "type": "object",
  "required": ["schema_version", "project_id", "canonical_name", "status", "created_at", "last_activity_at", "last_changed_at", "last_verified_at", "sources"],
  "properties": {
    "schema_version": {"type": "string"},
    "project_id": {"type": "string"},
    "canonical_name": {"type": "string"},
    "status": {"enum": ["active", "paused", "blocked", "completed", "canceled", "archived"]},
    "stage": {"type": ["string", "null"]},
    "current_version": {"type": ["string", "null"]},
    "owner": {"type": ["string", "null"]},
    "tech_world_role": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"},
    "last_activity_at": {"type": ["string", "null"], "format": "date-time"},
    "last_changed_at": {"type": ["string", "null"], "format": "date-time"},
    "last_verified_at": {"type": ["string", "null"], "format": "date-time"},
    "next_action": {"type": ["string", "null"]},
    "open_risks": {"type": "array", "items": {"type": "string"}},
    "open_work": {"type": "array", "items": {"type": "string"}},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_type", "source_ref"],
        "properties": {
          "source_type": {"type": "string"},
          "source_ref": {"type": "string"},
          "verified_at": {"type": ["string", "null"], "format": "date-time"},
          "notes": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
